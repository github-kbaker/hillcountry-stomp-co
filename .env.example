# Admin authentication secret — REQUIRED in production (Vercel).
#
# Generate it locally with:
#   bun run admin:password
# That prints a one-time password plus the JSON below. Paste the JSON (single
# line, exactly as printed) as the value of ADMIN_SECRET_JSON in Vercel for
# Production (and Preview). Never commit a real value; this file only
# documents the shape.
#
# ADMIN_SECRET_JSON={"passwordHash":"<hex>","passwordSalt":"<hex>","sessionKey":"<hex>"}
